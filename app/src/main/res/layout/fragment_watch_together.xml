<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context="org.newnewpipe.app.fragments.detail.WatchTogetherFragment">

    <!-- PANEL IDLE: nessuna sessione attiva -->
    <LinearLayout
        android:id="@+id/wt_idle_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/watch_together"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/wt_create_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/watch_together_create" />

        <EditText
            android:id="@+id/wt_ip_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/watch_together_host_ip"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/wt_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/watch_together_room_code"
            android:inputType="textCapCharacters"
            android:maxLines="1" />

        <EditText
            android:id="@+id/wt_port_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/watch_together_port"
            android:inputType="number"
            android:maxLines="1" />

        <Button
            android:id="@+id/wt_join_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/watch_together_join" />
    </LinearLayout>

    <!-- PANEL SESSIONE: stanza attiva -->
    <LinearLayout
        android:id="@+id/wt_session_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/wt_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Room ABCD · 2 participants · you are host" />

        <TextView
            android:id="@+id/wt_participants_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:textSize="15sp"
            tools:text="Mario ★\nLuigi" />

        <Button
            android:id="@+id/wt_leave_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/watch_together_leave" />
    </LinearLayout>
</LinearLayout>
